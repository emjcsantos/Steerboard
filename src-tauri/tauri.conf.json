{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steerboard",
  "version": "0.1.0",
  "identifier": "app.steerboard.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5173",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Steerboard",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
